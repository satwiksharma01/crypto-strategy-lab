{
  "name": "crypto-strategy-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Reviewable crypto spot strategy research with reproducible historical results.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/check-site.mjs",
    "agent": "node agent/server.mjs",
    "check:gemini": "node --env-file-if-exists=.env.local scripts/check-gemini.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  }
}
